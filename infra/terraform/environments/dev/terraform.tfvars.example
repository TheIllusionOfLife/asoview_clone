# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
project_id    = "asoview-clone-dev"
region        = "asia-northeast1"
zone          = "asia-northeast1-a"
support_email = "you@example.com"

# Let's Encrypt account registration email is NOT a terraform variable.
# After `terraform apply`, sed-replace REPLACE_WITH_ACME_EMAIL in
# infra/k8s/edge/clusterissuer.yaml with your real address (you receive
# ACME expiry warnings there). See docs/demo.md for the exact command.

# DuckDNS subdomain (the part before .duckdns.org). Claim one at
# https://www.duckdns.org. The full host becomes <this>.duckdns.org.
# Default matches the hostname committed in infra/k8s/edge/ingress.yaml.
duckdns_subdomain = "asoview-clone-dev"

# Optional: provide a domain you own (e.g. "asoview-clone.dev") to skip
# DuckDNS. When set AND duckdns_subdomain is empty, terraform creates a
# Cloud DNS zone + A record pointing at the static IP. Unused in the
# default DuckDNS flow.
domain = ""

# Cloud Billing budget for Vertex AI Search (Discovery Engine) guardrail.
# Find your billing account ID at https://console.cloud.google.com/billing
# Format: XXXXXX-XXXXXX-XXXXXX (uppercase alphanumerics).
billing_account_id = "REPLACE-ME-WITH-BILLING-ID"

# Email that receives Cloud Billing budget + monitoring alerts for dev.
notification_email = "you@example.com"
